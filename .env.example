# Neon Auth - from your Neon dashboard > Auth > Configuration
NEON_AUTH_BASE_URL=

# Cookie secret for session signing (min 32 chars)
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Postgres connection (pooled)
DATABASE_URL=

# Debug settings (optional)
DB_DEBUG=false
DB_DEBUG_FILTER=
LOG_LEVEL=info
